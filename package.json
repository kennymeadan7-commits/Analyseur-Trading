{
  "name": "analyseur-trading",
  "version": "1.0.0",
  "description": "Site serverless d'analyse technique de marché (RSI/EMA) déployé sur Netlify.",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
