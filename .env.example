# Copiez ce fichier en `.env` et renseignez vos valeurs.
# En production, configurez ces variables dans Netlify :
# Site settings > Environment variables.

# Jeton du bot Telegram (obtenu via @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz

# Identifiant du chat/canal destinataire des alertes
CHAT_ID=987654321

# Optionnel : symbole de la paire à analyser (défaut: BTCUSDT)
SYMBOL=BTCUSDT

# Optionnel : intervalle des bougies Binance (défaut: 15m)
INTERVAL=15m
